  {
    "name": "concurrent_ship_cancel",
    "acceptance": "S04-A04",
    "steps": [
      {
        "args": [
          "init"
        ],
        "expected": "200 initialized"
      },
      {
        "args": [
          "race"
        ],
        "expected": [
          "200 cancelled;409 cancelled;CANCELLED|CANCELLED|CANCELLED|10",
          "409 shipped;200 shipped;OPEN|SHIPPED|PENDING|5"
        ]
      }
    ]
