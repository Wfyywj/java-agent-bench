{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:java-agent-bench:paired-analysis-input:1.0",
  "title": "Paired analysis inputs; bundled examples are SYNTHETIC TEST FIXTURES NOT MODEL RESULTS",
  "description": "Use #/$defs/plan or #/$defs/records. CLI also enforces semantic constraints across records.",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/records"
    }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "tool",
        "workflow",
        "environment",
        "evaluator",
        "budget"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "workflow": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evaluator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_seconds",
            "max_tokens",
            "max_tool_calls"
          ],
          "properties": {
            "wall_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan_id",
        "data_class",
        "preregistered_at",
        "track",
        "arms",
        "pairs"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "data_class": {
          "enum": [
            "actual_agent_trials",
            "SYNTHETIC TEST FIXTURES NOT MODEL RESULTS"
          ]
        },
        "preregistered_at": {
          "type": "string",
          "format": "date-time"
        },
        "track": {
          "enum": [
            "model",
            "workflow",
            "budget",
            "system"
          ]
        },
        "arms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "A",
            "B"
          ],
          "properties": {
            "A": {
              "$ref": "#/$defs/metadata"
            },
            "B": {
              "$ref": "#/$defs/metadata"
            }
          }
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "implementation_id",
              "manifest_sha256",
              "repeat"
            ],
            "properties": {
              "implementation_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "repeat": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan_id",
        "data_class",
        "run_kind",
        "trial_id",
        "implementation_id",
        "manifest_sha256",
        "repeat",
        "arm",
        "started_at",
        "metadata",
        "outcome",
        "elapsed_seconds",
        "elapsed_unknown_reason",
        "cost_usd",
        "cost_unknown_reason",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "data_class": {
          "enum": [
            "actual_agent_trials",
            "SYNTHETIC TEST FIXTURES NOT MODEL RESULTS"
          ]
        },
        "run_kind": {
          "enum": [
            "agent_trial",
            "synthetic_replay"
          ]
        },
        "trial_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "implementation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "arm": {
          "enum": [
            "A",
            "B"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "infrastructure_failure"
          ]
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsed_unknown_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_unknown_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent_trace_sha256",
            "evaluation_sha256"
          ],
          "properties": {
            "agent_trace_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "evaluation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "elapsed_seconds": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "elapsed_unknown_reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": {
              "elapsed_unknown_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cost_usd": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "cost_unknown_reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": {
              "cost_unknown_reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run_kind": {
                "const": "synthetic_replay"
              }
            }
          },
          "then": {
            "properties": {
              "data_class": {
                "const": "SYNTHETIC TEST FIXTURES NOT MODEL RESULTS"
              }
            }
          }
        }
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  }
}
